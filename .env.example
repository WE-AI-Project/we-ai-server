# Copy this file to `.env` (and, if needed, `.env.<profile>` for profile-specific overrides — see
# DotenvApplicationContextInitializer) and fill in real values. `.env` and `.env.*` are gitignored
# and must NEVER be committed. Every secret below must be requested from the relevant service
# owner or console — do not invent placeholder-looking values and ship them to a real environment.

# ── Database ──
DB_HOST=localhost
DB_PORT=3307
DB_NAME=we_ai
DB_USERNAME=weai
# Real password required — do not leave blank or use a well-known default in a real deployment.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Docker Compose / Spring profile ──
# One of: dev, test, stag, prod. Controls which auth/mock safety guards are active
# (see AuthVerificationSecurityGuard) and which application-<profile>.yml is loaded.
APP_PROFILE=dev
APP_CONTAINER_NAME=we-ai-server-app
BACKEND_UPSTREAM=app:8080

# ── Nginx public entrypoint (Cloudflare Tunnel) ──
NGINX_IMAGE_TAG=stable-alpine
NGINX_CONTAINER_NAME=we-ai-nginx
NGINX_PORT=80
NGINX_SERVER_NAME=

# ── MySQL image/container ──
MYSQL_IMAGE_TAG=8.4
MYSQL_CONTAINER_NAME=we-ai-mysql

# ── MinIO ──
MINIO_IMAGE_TAG=latest
MINIO_MC_IMAGE_TAG=latest
MINIO_CONTAINER_NAME=we-ai-minio
MINIO_INIT_CONTAINER_NAME=we-ai-minio-init
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
# Real password required — do not reuse an old/weak value here.
MINIO_ROOT_PASSWORD=
MINIO_PUBLIC_BUCKET=we-ai-public
MINIO_PRIVATE_BUCKET=we-ai-private

# ── JWT ──
# Real, random secret required (>= 32 bytes) — never reuse the sample dev value from application.yml.
JWT_SECRET=
JWT_ISSUER=we-ai-server
JWT_ACCESS_TOKEN_EXPIRATION=PT1H
JWT_REFRESH_TOKEN_EXPIRATION=P7D

# ── Social login ──
# Kakao Developers (https://developers.kakao.com) > My Application > App Keys / Redirect URI
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=https://<your-domain>/api/v1/auth/kakao/callback
# Naver Developers (https://developers.naver.com/apps) > Application > Client credentials
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://<your-domain>/api/v1/auth/naver/callback
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-domain>/api/v1/auth/google/callback

# ── Public URLs used by the deployed profile ──
APP_BASE_URL=https://<your-domain>
APP_FRONTEND_BASE_URL=https://<your-domain>
APP_VITE_FRONTEND_BASE_URL=http://localhost:5173
APP_API_DOMAIN=<your-domain>
APP_FRONTEND_DOMAIN=https://<your-domain>
APP_STORAGE_CONSOLE_DOMAIN=localhost
# Must be false in any real deployment.
SWAGGER_ENABLED=false

# ── Dev bootstrap admin account (only wired up under the dev/test profiles) ──
APP_AUTH_USERNAME=dev-admin
APP_AUTH_PASSWORD=

# ── Email verification-code mock switches ──
# Must both stay false outside dev/test — AuthVerificationSecurityGuard refuses to start the
# app if either is true while APP_PROFILE is not dev/test. Only ever set to true in a local
# .env.dev / .env.test file.
AUTH_VERIFICATION_MOCK_ENABLED=false
AUTH_VERIFICATION_EXPOSE_CODE_IN_RESPONSE=false

# ── SMTP (used to send verification codes) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# A Gmail account + an App Password (not the account password) generated at
# https://myaccount.google.com/apppasswords, or your provider's SMTP credentials.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
AUTH_VERIFICATION_EMAIL_FROM=

# ── Ollama (self-hosted LLM backend) ──
OLLAMA_BASE_URL=https://<your-ollama-host>
# Only needed if Ollama sits behind Cloudflare Access.
OLLAMA_ACCESS_CLIENT_ID=
OLLAMA_ACCESS_CLIENT_SECRET=

# ── RAG vector store ──
# Must point at a real, reachable Chroma instance in every non-local environment — the
# application.yml default is localhost, which only works when Chroma runs on the same host
# as this server.
CHROMA_BASE_URL=http://localhost:8000
